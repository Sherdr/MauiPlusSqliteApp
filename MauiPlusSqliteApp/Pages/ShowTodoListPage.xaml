<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiPlusSqliteApp.ViewModels"
             x:Class="MauiPlusSqliteApp.Pages.ShowTodoListPage"
             Title="ShowTodoListPage">
    <VerticalStackLayout>
        
        <Label 
            Text="Welcome to Show Todolist!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <CollectionView
                ItemsSource="{Binding TodoList}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid
                        Padding="10"
                        ColumnDefinitions="*, Auto, Auto">

                        <Label 
                            Text="{Binding Title}"
                            VerticalOptions="Center" />

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>