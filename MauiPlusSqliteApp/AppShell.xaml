<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiPlusSqliteApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiPlusSqliteApp"
    xmlns:pageLocal="clr-namespace:MauiPlusSqliteApp.Pages"
    Title="MauiPlusSqliteApp">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="ShowTodoList"
        ContentTemplate="{DataTemplate pageLocal:ShowTodoListPage}"
        Route="ShowTodoList" />

</Shell>
